generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// ///////////////////////////////////////////////////
/// ///////////////// USER MODEL //////////////////////
/// ///////////////////////////////////////////////////
model User {
  id            String       @id @default(uuid())
  first_name    String
  last_name     String
  phone         String?
  birth_date    DateTime?
  gender        Gender?
  profile_img   String?
  position      Position?
  email         String       @unique
  password      String
  refresh_token String?
  role               Role
  status             UserStatus @default(ACTIVE)
  managerId          String?
  assignedStadiumId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  manager            User?      @relation("ManagerGuards", fields: [managerId], references: [id], onDelete: SetNull)
  createdGuards      User[]     @relation("ManagerGuards")
  stadiums           Stadium[]  @relation("ManagerStadiums")
  assignedStadium    Stadium?   @relation("GuardStadium", fields: [assignedStadiumId], references: [id], onDelete: SetNull)
  bookings           Booking[]  @relation("PlayerBookings")

  @@map("users")
}

/// ///////////////////////////////////////////////////
/// ///////////////// STADIUM MODEL ///////////////////
/// ///////////////////////////////////////////////////
model Stadium {
  id             String        @id @default(uuid())
  name           String
  city           String
  address        String
  images         String[]      @default([])
  latitude       Float?
  longitude      Float?
  status         StadiumStatus @default(PENDING)
  stadiumType    StadiumType   @default(FIVE_V_FIVE)
  priceFullMatch Float         @default(0)
  priceHalfMatch Float         @default(0)
  managerId      String
  manager        User          @relation("ManagerStadiums", fields: [managerId], references: [id], onDelete: Cascade)
  guards         User[]        @relation("GuardStadium")
  bookings       Booking[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("stadiums")
}

/// ///////////////////////////////////////////////////
/// ///////////////// BOOKING MODEL ///////////////////
/// ///////////////////////////////////////////////////
model Booking {
  id          String        @id @default(uuid())
  totalAmount Float
  matchType   MatchType     @default(FULL)
  scheduledAt DateTime?
  status      BookingStatus @default(PENDING)
  playerId    String
  stadiumId   String
  player      User          @relation("PlayerBookings", fields: [playerId], references: [id], onDelete: Cascade)
  stadium     Stadium       @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("bookings")
}

/// ///////////////////////////////////////////////////
/// ///////////////////// ENUMS ///////////////////////
/// ///////////////////////////////////////////////////
enum Role {
  ADMIN
  MANAGER
  GUARD
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum StadiumStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum MatchType {
  FULL
  HALF
}

enum StadiumType {
  FIVE_V_FIVE
  SEVEN_V_SEVEN
  EIGHT_V_EIGHT
  ELEVEN_V_ELEVEN
  INDOOR
}

enum Gender {
  MALE
  FEMALE
}

enum Position {
  GK
  DEF
  MID
  FWD
}
