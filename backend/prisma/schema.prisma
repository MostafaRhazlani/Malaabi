generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// ///////////////////////////////////////////////////
/// ///////////////// USER MODEL //////////////////////
/// ///////////////////////////////////////////////////
model User {
  id            String       @id @default(uuid())
  first_name    String
  last_name     String
  phone         String?
  birth_date    DateTime?
  gender        Gender?
  profile_img   String?
  position      Position?
  email         String       @unique
  password      String
  refresh_token String?
  role               Role
  status             UserStatus @default(ACTIVE)
  managerId          String?
  assignedStadiumId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  manager            User?      @relation("ManagerGuards", fields: [managerId], references: [id], onDelete: SetNull)
  createdGuards      User[]     @relation("ManagerGuards")
  stadiums           Stadium[]  @relation("ManagerStadiums")
  assignedStadium    Stadium?   @relation("GuardStadium", fields: [assignedStadiumId], references: [id], onDelete: SetNull)
  bookings           Booking[]  @relation("PlayerBookings")
  teams              Team[]     @relation("TeamMembers")
  ledTeams           Team[]     @relation("TeamLeader")
  teamRequests       TeamJoinRequest[] @relation("PlayerRequests")
  wallet             Wallet?

  @@map("users")
}

/// ///////////////////////////////////////////////////
/// ///////////////// WALLET MODEL ////////////////////
/// ///////////////////////////////////////////////////
model Wallet {
  id        String   @id @default(uuid())
  balance   Float    @default(0.0)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  description String?
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("transactions")
}

enum TransactionType {
  TOP_UP
  DEDUCT
  PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// ///////////////////////////////////////////////////
/// ///////////////// STADIUM MODEL ///////////////////
/// ///////////////////////////////////////////////////
model Stadium {
  id             String        @id @default(uuid())
  name           String
  city           String
  address        String
  images         String[]      @default([])
  latitude       Float?
  longitude      Float?
  status         StadiumStatus @default(PENDING)
  stadiumType    StadiumType   @default(FIVE_V_FIVE)
  priceFullMatch Float         @default(0)
  priceHalfMatch Float         @default(0)
  startTime      String        @default("08:00")
  endTime        String        @default("23:00")
  managerId      String
  manager        User          @relation("ManagerStadiums", fields: [managerId], references: [id], onDelete: Cascade)
  guards         User[]        @relation("GuardStadium")
  bookings       Booking[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("stadiums")
}

/// ///////////////////////////////////////////////////
/// ///////////////// BOOKING MODEL ///////////////////
/// ///////////////////////////////////////////////////
model Booking {
  id          String        @id @default(uuid())
  totalAmount Float
  matchType   MatchType     @default(FULL)
  scheduledAt DateTime?
  status      BookingStatus @default(PENDING)
  playerId    String
  stadiumId   String
  player      User          @relation("PlayerBookings", fields: [playerId], references: [id], onDelete: Cascade)
  stadium     Stadium       @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("bookings")
}

/// ///////////////////////////////////////////////////
/// /////////////////// TEAM MODEL ////////////////////
/// ///////////////////////////////////////////////////
model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  maxMembers  Int      @default(10)
  isPublic    Boolean  @default(true)
  leaderId    String
  leader      User     @relation("TeamLeader", fields: [leaderId], references: [id])
  members     User[]   @relation("TeamMembers")
  requests    TeamJoinRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

/// ///////////////////////////////////////////////////
/// ///////////////////// ENUMS ///////////////////////
/// ///////////////////////////////////////////////////
enum Role {
  ADMIN
  MANAGER
  GUARD
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum StadiumStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum MatchType {
  FULL
  HALF
}

enum StadiumType {
  FIVE_V_FIVE
  SEVEN_V_SEVEN
  EIGHT_V_EIGHT
  ELEVEN_V_ELEVEN
  INDOOR
}

enum Gender {
  MALE
  FEMALE
}

enum Position {
  GK
  DEF
  MID
  FWD
}

model TeamJoinRequest {
  id        String @id @default(uuid())
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String
  player    User   @relation("PlayerRequests", fields: [playerId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING)
  type      RequestType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, playerId])
  @@map("team_join_requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RequestType {
  REQUEST
  INVITATION
}
